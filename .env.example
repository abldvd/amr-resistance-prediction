# =============================================================================
# AMR Project — Variables de entorno
# Copia este archivo como .env y completa los valores.
# NUNCA hagas commit de .env (está en .gitignore).
# =============================================================================

# --- BV-BRC API (opcional — algunos endpoints son públicos sin auth) ---------
# BVBRC_TOKEN=tu_token_aqui

# --- JupyterLab ---------------------------------------------------------------
JUPYTER_PORT=8888

# --- Rutas de datos -----------------------------------------------------------
# Ruta a los datos. Por defecto dentro del propio proyecto.
AMR_DATA_DIR=./data

# --- Reproducibilidad ML ------------------------------------------------------
RANDOM_SEED=42

# --- Configuración del pipeline -----------------------------------------------
# Antibiótico objetivo (para filtrar fenotipos)
TARGET_ANTIBIOTIC=Ciprofloxacin

# Tamaño de k para k-mers (31 es estándar en literatura AMR-ML)
KMER_SIZE=31

# Número de k-mers top a conservar tras filtrado por document frequency
N_TOP_KMERS=100000
