# ============================================================================
# .env — Variables de entorno para el proyecto AMR
# Copia: cp .env.example .env (o copy .env.example .env en PowerShell)
# No subas .env a git — ya está en .gitignore.
# ============================================================================

# BV-BRC API (no requiere autenticación para datos públicos)
BVBRC_API_URL=https://www.bv-brc.org/api

# Jupyter
JUPYTER_TOKEN=
