{
  // ==========================================================================
  // AMR Resistance Prediction — Dev Container (VSCode)
  // Extensión requerida: "Dev Containers" (ms-vscode-remote.remote-containers)
  // Abre el proyecto en VSCode → F1 → "Dev Containers: Reopen in Container"
  //
  // SELECCIÓN DE DISPOSITIVO:
  //   CPU (por defecto): no cambies nada.
  //   GPU: comenta las líneas marcadas con [CPU] y descomenta las de [GPU].
  // ==========================================================================

  "name": "AMR — CPU",                  // [CPU] cambia a "AMR — GPU" si usas GPU

  "dockerComposeFile": ["../docker-compose.yml"],

  "service": "dev-cpu",                 // [CPU] → para GPU: "dev-gpu"
  "runServices": ["dev-cpu"],           // [CPU] → para GPU: ["dev-gpu"]

  "workspaceFolder": "/workspace",

  // Reenvío de puertos al host
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "openBrowser"
    }
  },

  // Scripts de ciclo de vida
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "echo '✅ AMR Dev Container listo — http://localhost:8888'",

  // Extensiones de VSCode instaladas automáticamente en el contenedor
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "ms-python.pylint",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "christian-kohler.path-intellisense",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-spanish",
        "mechatroner.rainbow-csv",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": false,
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "ruff.enable": true,
        "ruff.organizeImports": true,
        "jupyter.jupyterServerType": "local",
        "jupyter.notebookFileRoot": "/workspace",
        "editor.rulers": [88],
        "editor.tabSize": 4,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/*.pyc": true,
          "**/.pytest_cache": true,
          "**/.ruff_cache": true
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // SSH forwarding para git push desde el contenedor
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "PYTHONPATH": "/workspace/src",
    "PYTHONDONTWRITEBYTECODE": "1",
    "SSH_AUTH_SOCK": "/ssh-agent"
  }
}
