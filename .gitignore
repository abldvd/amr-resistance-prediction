# =============================================================================
# AMR Project — .gitignore
# =============================================================================

# --- Datos (nunca versionar por tamaño y licencia BV-BRC) -------------------
datos/brutos/
datos/procesados/
*.fasta
*.fastq
*.npz
*.npy

# --- Outputs de modelos ------------------------------------------------------
outputs/models/
outputs/figures/
informes/figuras/

# --- Variables de entorno (contienen tokens/secretos) -----------------------
.env
# .env.example SÍ se versiona (es la plantilla pública)

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
.eggs/

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
# Los notebooks SÍ se versionan pero sin outputs:
# Instala nbstripout: pip install nbstripout && nbstripout --install

# --- Docker ------------------------------------------------------------------
# No ignorar docker-compose.yml ni Dockerfile (son parte del proyecto)

# --- macOS -------------------------------------------------------------------
.DS_Store
.AppleDouble

# --- VSCode ------------------------------------------------------------------
# .vscode/ se puede versionar si quieres compartir settings con el equipo
# En este proyecto NO lo ignoramos para que el devcontainer funcione bien
# .vscode/

# --- Misc --------------------------------------------------------------------
*.log
*.tmp
.hypothesis/
