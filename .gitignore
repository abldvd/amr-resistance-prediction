# ── Datos (demasiado grandes para git) ─────────────────────────────────────
datos/brutos/*
datos/procesados/*
!datos/brutos/.gitkeep
!datos/brutos/genomas_fasta/
datos/brutos/genomas_fasta/*
!datos/brutos/genomas_fasta/.gitkeep
!datos/procesados/.gitkeep

# ── Modelos y figuras generados ─────────────────────────────────────────────
modelos/*
figuras/*
!modelos/.gitkeep
!figuras/.gitkeep

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Entorno ────────────────────────────────────────────────────────────────
.env
.venv/

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Dev Container (generado por init.bat, no versionar) ─────────────────────
docker-compose.devcontainer.yml

# ── Claude Code ─────────────────────────────────────────────────────────────
.claude/
CLAUDE.md
